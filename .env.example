# Copie a .env y cambie los valores. Nunca suba .env al repositorio.
DATABASE_URL="postgresql://usuario:clave@localhost:5432/homeoutlet"
AUTH_SECRET="(genere uno con: npx auth secret)"
CHANNELS_ENABLED=simulado

# WhatsApp Business Platform (Cloud API). Para activarlo: llene las cuatro y use CHANNELS_ENABLED=simulado,whatsapp
# WHATSAPP_TOKEN=               (Meta for Developers → WhatsApp → Configuración de la API; el temporal dura 24 h)
# WHATSAPP_PHONE_NUMBER_ID=     (el «Phone Number ID» de esa misma pantalla)
# WHATSAPP_APP_SECRET=          (Configuración de la app → Básica → Clave secreta)
# WHATSAPP_VERIFY_TOKEN=        (la inventa usted; se escribe igual al configurar el webhook en Meta)
# WHATSAPP_BUSINESS_ACCOUNT_ID= (opcional; «Identificador de la cuenta de mensajes» en Configuración de la API. Sin él no hay plantillas)

# Facebook Messenger e Instagram (mensajes directos). Para activarlos: llene las cuatro de cada uno y agréguelos a CHANNELS_ENABLED.
# El secreto y el token de verificación pueden repetirse si las dos cuentas están en la misma app de Meta.
# FACEBOOK_PAGE_TOKEN=          (token de acceso de la página)
# FACEBOOK_PAGE_ID=             (el id de la página: llega como entry[].id en el webhook)
# FACEBOOK_APP_SECRET=          (Configuración de la app → Básica → Clave secreta)
# FACEBOOK_VERIFY_TOKEN=        (la inventa usted; se escribe igual al configurar el webhook en Meta)
# INSTAGRAM_TOKEN=              (token de la página de Facebook vinculada a la cuenta de Instagram)
# INSTAGRAM_ACCOUNT_ID=         (el id de la cuenta profesional de Instagram)
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_VERIFY_TOKEN=

# Asistente con IA (fase 2). Sin clave, corre en modo de prueba con un proveedor simulado.
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-5-5
# AI_MONTHLY_BUDGET_USD=10
# AI_PRICE_INPUT_PER_MTOK=1
# AI_PRICE_OUTPUT_PER_MTOK=5

# Secreto para el cron que vence las reservas sin pago (POST /api/tareas/vencer-reservas con "Authorization: Bearer <secreto>").
# También protege POST /api/tareas/desconectar-asesores (pasa a Desconectado a quien lleva 5 min sin señal; llámela cada minuto).
# Déjelo vacío mientras no haya cron: las rutas quedan apagadas.
TAREAS_SECRET=

# --- Solo en producción ---
# Cuántos proxies hay delante del servidor (Railway, Vercel, Nginx: normalmente 1). Sin esto el inicio de sesión se limita solo por
# correo y no por IP, porque la cabecera x-forwarded-for la puede escribir cualquiera si no hay un proxy propio que la fije.
# PROXIES_CONFIABLES=1
# La dirección pública del sistema, o AUTH_TRUST_HOST=true, para que el inicio de sesión funcione detrás de un proxy.
# AUTH_URL=https://crm.ejemplo.com
# Respaldos (npm run respaldo): carpeta (mejor en otro disco) y cuántos conservar. Necesita pg_dump (cliente de PostgreSQL).
# RESPALDOS_CARPETA=/ruta/al/disco
# RESPALDOS_CONSERVAR=14
