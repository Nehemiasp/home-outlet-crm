# Copie a .env y cambie los valores. Nunca suba .env al repositorio.
DATABASE_URL="postgresql://usuario:clave@localhost:5432/homeoutlet"
AUTH_SECRET="(genere uno con: npx auth secret)"
# Segundo factor (código de una aplicación de autenticación) para administradores y jefes de tienda. En producción es obligatorio y no se puede apagar.
# En desarrollo está apagado para que la demostración siga abierta; SEGUNDO_FACTOR=1 lo enciende para probarlo.
# SEGUNDO_FACTOR=1
CHANNELS_ENABLED=simulado

# WhatsApp Business Platform (Cloud API). Para activarlo: llene las cuatro y use CHANNELS_ENABLED=simulado,whatsapp
# WHATSAPP_TOKEN=               (Meta for Developers → WhatsApp → Configuración de la API; el temporal dura 24 h)
# WHATSAPP_PHONE_NUMBER_ID=     (el «Phone Number ID» de esa misma pantalla)
# WHATSAPP_APP_SECRET=          (Configuración de la app → Básica → Clave secreta)
# WHATSAPP_VERIFY_TOKEN=        (la inventa usted; se escribe igual al configurar el webhook en Meta)
# WHATSAPP_BUSINESS_ACCOUNT_ID= (opcional; «Identificador de la cuenta de mensajes» en Configuración de la API. Sin él no hay plantillas)

# Facebook Messenger e Instagram (mensajes directos). Para activarlos: llene las cuatro de cada uno y agréguelos a CHANNELS_ENABLED.
# El secreto y el token de verificación pueden repetirse si las dos cuentas están en la misma app de Meta.
# FACEBOOK_PAGE_TOKEN=          (token de acceso de la página)
# FACEBOOK_PAGE_ID=             (el id de la página: llega como entry[].id en el webhook)
# FACEBOOK_APP_SECRET=          (Configuración de la app → Básica → Clave secreta)
# FACEBOOK_VERIFY_TOKEN=        (la inventa usted; se escribe igual al configurar el webhook en Meta)
# INSTAGRAM_TOKEN=              (token de la página de Facebook vinculada a la cuenta de Instagram)
# INSTAGRAM_ACCOUNT_ID=         (el id de la cuenta profesional de Instagram)
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_VERIFY_TOKEN=

# Pago con tarjeta (pasarela). Sin esto, la tarjeta no se puede encender en Ajustes → Pagos y envíos.
# PASARELA=simulada   (solo para probar, fuera de producción: no mueve dinero; la página de pago es /pagar/<id>)
# Un proveedor real se agrega en lib/pagos-tarjeta/index.ts (ver PASARELA-TARJETA.md). Su webhook va a POST /api/pagos/webhook.
# PASARELA_SECRETO=   (firma del aviso de la pasarela simulada; si falta se deriva de AUTH_SECRET)

# Asistente con IA (fase 2). Sin clave, corre en modo de prueba con un proveedor simulado.
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-5-5
# AI_MONTHLY_BUDGET_USD=10
# AI_PRICE_INPUT_PER_MTOK=1
# AI_PRICE_OUTPUT_PER_MTOK=5

# Las tareas (vencer reservas sin pago, desconectar asesores inactivas) ya corren dentro del servidor en producción: no hace falta un cron.
# Solo si prefiere un cron externo: este secreto abre POST /api/tareas/vencer-reservas y POST /api/tareas/desconectar-asesores con "Authorization: Bearer <secreto>".
# Vacío = esas rutas no existen.
TAREAS_SECRET=

# --- Solo en producción ---
# Cuántos proxies hay delante del servidor (Railway, Vercel, Nginx: normalmente 1). Sin esto el inicio de sesión se limita solo por
# correo y no por IP, porque la cabecera x-forwarded-for la puede escribir cualquiera si no hay un proxy propio que la fije.
# PROXIES_CONFIABLES=1
# La dirección pública del sistema, o AUTH_TRUST_HOST=true, para que el inicio de sesión funcione detrás de un proxy.
# AUTH_URL=https://crm.ejemplo.com
# Disco persistente para las fotos y los comprobantes (en el Dockerfile ya viene /data/uploads). Sin esto se pierden al reiniciar.
# UPLOADS_DIR=/data/uploads
# Respaldo diario a las 2:00 de Guatemala (base y archivos) dentro del propio servidor. Necesita pg_dump (el Dockerfile lo trae).
# RESPALDO_AUTOMATICO=1
# Carpeta de los respaldos (mejor en un volumen) y cuántos conservar. También sirven para «npm run respaldo» a mano.
# RESPALDOS_CARPETA=/data/respaldos
# RESPALDOS_CONSERVAR=14

# TikTok (mensajes directos de una cuenta TikTok Business). Para activarlo: llene las tres y agregue tiktok a CHANNELS_ENABLED.
# Hace falta que TikTok apruebe el acceso a mensajes de la cuenta del negocio. Todavía no está probado con TikTok real.
# TIKTOK_ACCESS_TOKEN=          (token de acceso de la cuenta del negocio)
# TIKTOK_BUSINESS_ID=           (el id de la cuenta del negocio: llega como business_id en el webhook)
# TIKTOK_APP_SECRET=            (clave secreta de la app: con ella se verifica la firma de los webhooks)
# Solo para desarrollo, para probar TikTok completo sin cuenta: inventar las tres de arriba y apuntar a la API simulada que trae el sistema.
# TIKTOK_API_URL=http://localhost:3000/api/simulador/tiktok
